<header class="m-header" data-header>
    <div class="m-header__inner m-wrap">

        <a class="m-brand" href="{{@site.url}}">
            {{#if @site.logo}}
                <img class="m-brand__logo" src="{{@site.logo}}" alt="{{@site.title}}">
            {{else}}
                {{#if @site.icon}}
                    <img class="m-brand__icon" src="{{img_url @site.icon size="xs"}}" alt="" width="28" height="28">
                {{/if}}
                <span class="m-brand__title">{{@site.title}}</span>
            {{/if}}
        </a>

        <nav class="m-nav" aria-label="{{t "Main"}}" data-nav>
            {{navigation}}

            {{#if @site.members_enabled}}
                <div class="m-nav__members">
                    {{#unless @member}}
                        <a class="m-nav__link" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                        {{#unless @site.members_invite_only}}
                            <a class="m-button" href="#/portal/signup" data-portal="signup">{{> "subscribe-label"}}</a>
                        {{/unless}}
                    {{else}}
                        <a class="m-button m-button--ghost" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                    {{/unless}}
                </div>
            {{/if}}
        </nav>

        <div class="m-header__actions">
            <button class="m-icon-button" type="button" aria-label="{{t "Search"}}" data-ghost-search>{{> "icons/search"}}</button>
            <button class="m-icon-button m-burger" type="button" aria-label="{{t "Menu"}}" aria-expanded="false" data-burger>
                <span class="m-burger__open">{{> "icons/menu"}}</span>
                <span class="m-burger__close">{{> "icons/close"}}</span>
            </button>
        </div>

    </div>
</header>

{{#is "post"}}
    {{#if @custom.show_reading_progress}}
        <div class="m-progress" aria-hidden="true"><div class="m-progress__bar" data-progress></div></div>
    {{/if}}
{{/is}}
