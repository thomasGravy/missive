<footer class="m-footer">
    <div class="m-footer__inner m-wrap">

        <div class="m-footer__brand">
            <a class="m-footer__title" href="{{@site.url}}">{{@site.title}}</a>
            <p class="m-footer__copy">&copy; {{date format="YYYY"}} {{@site.title}}</p>
            {{#if @custom.show_theme_credit}}
                {{> "theme-credit"}}
            {{/if}}
        </div>

        <nav class="m-footer__nav" aria-label="{{t "Footer"}}">
            {{navigation type="secondary"}}
        </nav>

        <div class="m-footer__social">
            {{#if @site.twitter}}
                <a class="m-icon-button" href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">{{> "icons/x"}}</a>
            {{/if}}
            {{#if @site.facebook}}
                <a class="m-icon-button" href="{{social_url type="facebook"}}" target="_blank" rel="noopener" aria-label="Facebook">{{> "icons/facebook"}}</a>
            {{/if}}
            <a class="m-icon-button" href="{{@site.url}}/rss/" aria-label="RSS">{{> "icons/rss"}}</a>
        </div>

    </div>
</footer>
