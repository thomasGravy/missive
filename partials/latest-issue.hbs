<section class="m-latest-wrap m-wrap">
    <article class="m-latest {{post_class}}{{#if feature_image}} has-image{{/if}}" data-issue>
        <div class="m-latest__content">
            <p class="m-kicker">
                <span class="m-kicker__accent">{{t "Latest issue"}}</span>
                <span class="m-kicker__no" data-issue-no></span>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                {{#if featured}}
                    <span class="m-featured">{{> "icons/star"}}<span>{{t "Featured"}}</span></span>
                {{/if}}
            </p>
            <h2 class="m-latest__title"><a href="{{url}}">{{title}}</a></h2>
            <p class="m-latest__excerpt">{{excerpt words="55"}}</p>
            <div class="m-latest__footer">
                <a class="m-button" href="{{url}}">{{t "Read the issue"}} {{> "icons/arrow-right"}}</a>
                {{#if reading_time}}
                    <span class="m-latest__time">{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
                {{/if}}
                {{#match visibility "!=" "public"}}
                    <span class="m-latest__access">{{> "icons/lock"}} {{#match visibility "members"}}{{t "Members only"}}{{else}}{{t "Paid subscribers"}}{{/match}}</span>
                {{/match}}
            </div>
        </div>
        {{#if feature_image}}
            <a class="m-latest__image" href="{{url}}" tabindex="-1" aria-hidden="true">
                <img
                    srcset="{{img_url feature_image size="s"}} 320w,
                            {{img_url feature_image size="m"}} 720w,
                            {{img_url feature_image size="l"}} 1080w"
                    sizes="(max-width: 800px) 100vw, 420px"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                >
            </a>
        {{/if}}
    </article>
</section>
